# Allow common video types; block scripts
<FilesMatch "\.(?i:mp4|webm|mov|m4v|ogg|ogv)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</FilesMatch>

<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|phps|cgi|pl|py|exe|sh|html|htm|js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5
RemoveType .php .phtml .php3 .php4 .php5
